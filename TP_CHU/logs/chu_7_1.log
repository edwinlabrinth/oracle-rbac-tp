SQL> -- Procedure d'alerte (transaction autonome pour survivre a un ROLLBACK)
SQL> PROMPT === Creation de AUDIT_CHU.ALERTE_FGA ===
=== Creation de AUDIT_CHU.ALERTE_FGA ===
SQL> CREATE OR REPLACE PROCEDURE audit_chu.alerte_fga (
  2    p_schema  VARCHAR2,
  3    p_objet	 VARCHAR2,
  4    p_politique VARCHAR2
  5  ) AS
  6    PRAGMA AUTONOMOUS_TRANSACTION;
  7    v_utilisateur VARCHAR2(30);
  8    v_poste	     VARCHAR2(60);
  9    v_programme	VARCHAR2(60);
 10  BEGIN
 11    SELECT SYS_CONTEXT('USERENV','SESSION_USER'),
 12  	      SYS_CONTEXT('USERENV','HOST'),
 13  	      SYS_CONTEXT('USERENV','CLIENT_PROGRAM_NAME')
 14  	 INTO v_utilisateur, v_poste, v_programme
 15  	 FROM dual;
 16    INSERT INTO audit_chu.alertes (utilisateur, poste, programme, objet, politique)
 17    VALUES (v_utilisateur, v_poste, v_programme, p_objet, p_politique);
 18    COMMIT;
 19  END;
 20  /

Procedure created.

