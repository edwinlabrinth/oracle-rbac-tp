SQL> -- 3. Roles et alimentation
SQL> CREATE ROLE r_connexion;

Role created.

SQL> GRANT CREATE SESSION TO r_connexion;

Grant succeeded.

SQL> 
SQL> CREATE ROLE r_rh_lecteur;

Role created.

SQL> GRANT SELECT ON rh.departements TO r_rh_lecteur;

Grant succeeded.

SQL> GRANT SELECT ON rh.v_annuaire TO r_rh_lecteur;

Grant succeeded.

SQL> GRANT r_connexion TO r_rh_lecteur;

Grant succeeded.

SQL> 
SQL> CREATE ROLE r_rh_gestion;

Role created.

SQL> GRANT r_rh_lecteur TO r_rh_gestion;

Grant succeeded.

SQL> GRANT SELECT, INSERT ON rh.employes TO r_rh_gestion;

Grant succeeded.

SQL> GRANT UPDATE (poste, dept_id) ON rh.employes TO r_rh_gestion;

Grant succeeded.

SQL> GRANT r_connexion TO r_rh_gestion;

Grant succeeded.

SQL> 
SQL> CREATE ROLE r_rh_paie;

Role created.

SQL> GRANT SELECT ON rh.employes TO r_rh_paie;

Grant succeeded.

SQL> GRANT UPDATE (salaire) ON rh.employes TO r_rh_paie;

Grant succeeded.

SQL> GRANT r_connexion TO r_rh_paie;

Grant succeeded.

SQL> 
SQL> -- Attribution aux utilisateurs
SQL> GRANT r_rh_lecteur TO lina;

Grant succeeded.

SQL> GRANT r_rh_gestion TO omar;

Grant succeeded.

SQL> GRANT r_rh_paie TO sara;

Grant succeeded.

