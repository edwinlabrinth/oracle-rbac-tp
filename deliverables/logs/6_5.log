SQL> -- FGA : gros montants sur les insertions dans OPERATIONS (montant >= 50000)
SQL> PROMPT === Création de la politique FGA FGA_BQ_GROS_MONTANTS ===
=== Création de la politique FGA FGA_BQ_GROS_MONTANTS ===
SQL> BEGIN
  2    DBMS_FGA.ADD_POLICY(
  3  	 object_schema	 => 'BANQUE',
  4  	 object_name	 => 'OPERATIONS',
  5  	 policy_name	 => 'FGA_BQ_GROS_MONTANTS',
  6  	 audit_condition => 'MONTANT >= 50000',
  7  	 statement_types => 'INSERT',
  8  	 enable 	 => TRUE);
  9  END;
 10  /

