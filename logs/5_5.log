SQL> -- POL_RH_ADHOC : tentative avec clause WHEN (echoue ORA-01756 en 26ai -> ecart documente)
SQL> PROMPT === POL_RH_ADHOC : tentative avec clause WHEN SYS_CONTEXT (attendu ORA-01756) ===
=== POL_RH_ADHOC : tentative avec clause WHEN SYS_CONTEXT (attendu ORA-01756) ===
SQL> CREATE AUDIT POLICY pol_rh_adhoc
  2    ACTIONS SELECT, UPDATE, DELETE ON rh.employes
  3    WHEN 'SYS_CONTEXT(''USERENV'',''CLIENT_PROGRAM_NAME'') = ''sqlplus@325ea919716d (TNS V1-V3)'' EVALUATE PER SESSION;
