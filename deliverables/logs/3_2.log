SQL> -- 3. Privileges objet directs ou via les roles de l'arbre
SQL> COLUMN source FORMAT A8
SQL> COLUMN grantee FORMAT A16
SQL> COLUMN owner FORMAT A8
SQL> COLUMN table_name FORMAT A16
SQL> COLUMN privilege FORMAT A12
SQL> COLUMN column_name FORMAT A12
SQL> PROMPT === Privileges objet d'OMAR (directs + via roles) ===
=== Privileges objet d'OMAR (directs + via roles) ===
SQL> WITH roles AS (
  2    SELECT granted_role AS r
  3  	 FROM dba_role_privs
  4  	START WITH grantee = 'OMAR'
  5  	CONNECT BY PRIOR granted_role = grantee
  6  )
  7  SELECT 'TABLE' AS source, grantee, owner, table_name, privilege,
  8  	    CAST(NULL AS VARCHAR2(30)) AS column_name
  9    FROM dba_tab_privs
 10   WHERE grantee = 'OMAR' OR grantee IN (SELECT r FROM roles)
 11  UNION ALL
 12  SELECT 'COLONNE', grantee, owner, table_name, privilege, column_name
 13    FROM dba_col_privs
 14   WHERE grantee = 'OMAR' OR grantee IN (SELECT r FROM roles)
 15   ORDER BY 1, 2, 3, 4, 5, 6;

SOURCE	 GRANTEE	  OWNER    TABLE_NAME	    PRIVILEGE	 COLUMN_NAME
