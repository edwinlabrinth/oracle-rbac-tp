SQL> -- 3_7.sql : Exercice 3.7 -- Analyse des privileges (DBMS_PRIVILEGE_CAPTURE)
SQL> SET LINESIZE 120 PAGESIZE 60
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> -- 1. Creation et demarrage d'une capture limitee aux sessions d'OMAR
SQL> BEGIN
  2    DBMS_PRIVILEGE_CAPTURE.CREATE_CAPTURE(
  3  	 name	   => 'cap_omar',
  4  	 type	   => DBMS_PRIVILEGE_CAPTURE.G_CONTEXT,
  5  	 condition => 'SYS_CONTEXT(''USERENV'',''SESSION_USER'') = ''OMAR''');
  6  END;
  7  /

PL/SQL procedure successfully completed.

SQL> EXEC DBMS_PRIVILEGE_CAPTURE.ENABLE_CAPTURE(name => 'cap_omar');

PL/SQL procedure successfully completed.

SQL> 
SQL> -- 2. Activite d'OMAR
SQL> CONNECT omar/"Omar#2026"@//localhost/FREEPDB1
Connected.
SQL> SELECT COUNT(*) AS annuaire FROM rh.v_annuaire;

  ANNUAIRE
----------
	 8

1 row selected.

SQL> UPDATE rh.employes SET poste = 'Architecte' WHERE emp_id = 3;

1 row updated.

SQL> ROLLBACK;

Rollback complete.

SQL> 
SQL> -- 3. Arret, generation et comparaison des resultats
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> EXEC DBMS_PRIVILEGE_CAPTURE.DISABLE_CAPTURE(name => 'cap_omar');

PL/SQL procedure successfully completed.

SQL> EXEC DBMS_PRIVILEGE_CAPTURE.GENERATE_RESULT(name => 'cap_omar');

PL/SQL procedure successfully completed.

SQL> 
SQL> COLUMN capture FORMAT A10
SQL> COLUMN username FORMAT A10
SQL> COLUMN used_role FORMAT A14
SQL> COLUMN rolename FORMAT A14
SQL> COLUMN obj_priv FORMAT A10
SQL> COLUMN object_owner FORMAT A10
SQL> COLUMN object_name FORMAT A16
SQL> COLUMN column_name FORMAT A12
SQL> PROMPT === DBA_USED_OBJPRIVS (privileges reellement utilises) ===
=== DBA_USED_OBJPRIVS (privileges reellement utilises) ===
SQL> SELECT capture, username, used_role, obj_priv, object_owner, object_name, column_name
  2    FROM dba_used_objprivs WHERE capture = 'CAP_OMAR'
  3   ORDER BY object_name, column_name, obj_priv;

