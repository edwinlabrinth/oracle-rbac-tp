SQL> -- Relire la trace après purge (la purge elle-même est tracee)
SQL> COLUMN dbusername FORMAT A15
SQL> COLUMN action_name FORMAT A25
SQL> COLUMN unified_audit_policies FORMAT A25
SQL> PROMPt === Trace après purge (la purge est tracee) ===
=== Trace après purge (la purge est tracee) ===
SQL> SELECT event_timestamp, dbusername, action_name, unified_audit_policies
  2    FROM unified_audit_trail
  3   WHERE event_timestamp > SYSTIMESTAMP - INTERVAL '10' MINUTE
  4   ORDER BY event_timestamp DESC;

