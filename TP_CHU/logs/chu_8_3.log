SQL> -- Trigger : avant UPDATE ou DELETE sur PRESCRIPTIONS
SQL> -- Si l'utilisateur est un medecin (login = SESSION_USER) et n'est pas le prescripteur,
SQL> -- journaliser REFUS_PRESC puis lever -20010
SQL> PROMPT === Creation de TRG_CTRL_PRESC ===
=== Creation de TRG_CTRL_PRESC ===
SQL> CREATE OR REPLACE TRIGGER trg_ctrl_presc
  2    BEFORE UPDATE OR DELETE ON chu.prescriptions
  3    FOR EACH ROW
  4  DECLARE
  5    v_fonction   VARCHAR2(12);
  6    v_pers_id    NUMBER;
  7    v_is_medecin BOOLEAN := FALSE;
  8    v_is_prescripteur BOOLEAN := FALSE;
  9  BEGIN
 10    -- Verifier si l'utilisateur courant est un medecin du personnel
 11    SELECT fonction, pers_id
 12  	 INTO v_fonction, v_pers_id
 13  	 FROM chu.personnel
 14  	WHERE login = SYS_CONTEXT('USERENV','SESSION_USER');
 15  
 16    IF v_fonction = 'MEDECIN' THEN
 17  	 v_is_medecin := TRUE;
 18  	 -- Verifier si ce medecin est le prescripteur de la prescription
 19  	 IF :OLD.medecin_id = v_pers_id THEN
 20  	   v_is_prescripteur := TRUE;
 21  	 END IF;
 22    END IF;
 23  
 24    -- Si medecin mais pas le prescripteur : refuser
 25    IF v_is_medecin AND NOT v_is_prescripteur THEN
 26  	 audit_chu.log_evt('REFUS_PRESC', 'PRESCRIPTIONS',
 27  	   'Medecin ' || SYS_CONTEXT('USERENV','SESSION_USER') ||
 28  	   ' tente de modifier la prescription ' || :OLD.presc_id ||
 29  	   ' dont le prescripteur est ' || :OLD.medecin_id);
 30  	 RAISE_APPLICATION_ERROR(-20010, 'Seul le prescripteur peut modifier sa prescription');
 31    END IF;
 32  EXCEPTION
 33    WHEN NO_DATA_FOUND THEN
 34  	 -- L'utilisateur n'est pas dans le personnel (ex: APP_CHU), ne rien faire
 35  	 NULL;
 36  END;
 37  /

Trigger created.

