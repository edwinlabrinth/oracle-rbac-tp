SQL> -- 3. Identification puis terminaison de la session
SQL> COLUMN username FORMAT A12
SQL> SELECT sid, serial#, status FROM v$session WHERE username = 'ALI';

       SID    SERIAL# STATUS
---------- ---------- --------
       221	47280 ACTIVE

1 row selected.

SQL> 
SQL> BEGIN
  2    FOR r IN (SELECT sid, serial# FROM v$session WHERE username = 'ALI') LOOP
  3  	 EXECUTE IMMEDIATE 'ALTER SYSTEM KILL SESSION ''' || r.sid || ',' || r.serial# || ''' IMMEDIATE';
  4    END LOOP;
  5  END;
  6  /
BEGIN
*
ERROR at line 1:
ORA-00031: session marked for kill
ORA-06512: at line 3
ORA-06512: at line 3
Help: https://docs.oracle.com/error-help/db/ora-00031/


SQL> EXEC DBMS_SESSION.SLEEP(3);

PL/SQL procedure successfully completed.

SQL> SELECT sid, serial#, status FROM v$session WHERE username = 'ALI';

no rows selected

SQL> 
SQL> -- Suppression definitive apres liberation de la session
SQL> DROP USER ali CASCADE;

