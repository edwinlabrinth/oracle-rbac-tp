SQL> -- 2. Arbre complet des roles d'OMAR
SQL> COLUMN arbre FORMAT A40
SQL> PROMPT === Arbre des roles d'OMAR (CONNECT BY) ===
=== Arbre des roles d'OMAR (CONNECT BY) ===
SQL> SELECT LPAD(' ', 2 * (LEVEL - 1)) || granted_role AS arbre
  2    FROM dba_role_privs
  3   START WITH grantee = 'OMAR'
  4   CONNECT BY PRIOR granted_role = grantee;

