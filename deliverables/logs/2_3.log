SQL> -- 1. OMAR : modification du poste et du departement uniquement
SQL> CREATE USER omar IDENTIFIED BY "Omar#2026";

User created.

SQL> GRANT CREATE SESSION TO omar;

Grant succeeded.

SQL> GRANT UPDATE (poste, dept_id) ON rh.employes TO omar;

Grant succeeded.

SQL> 
SQL> -- 2. Trois UPDATE successifs (puis ROLLBACK a chaque fois)
SQL> CONNECT omar/"Omar#2026"@//localhost/FREEPDB1
Connected.
SQL> UPDATE rh.employes SET salaire = 99999;
UPDATE rh.employes SET salaire = 99999
          *
ERROR at line 1:
ORA-41900: missing UPDATE privilege on "RH"."EMPLOYES"
Help: https://docs.oracle.com/error-help/db/ora-41900/


SQL> ROLLBACK;

Rollback complete.

SQL> UPDATE rh.employes SET poste = 'Architecte' WHERE emp_id = 3;
UPDATE rh.employes SET poste = 'Architecte' WHERE emp_id = 3
          *
ERROR at line 1:
ORA-41900: missing SELECT privilege on "RH"."EMPLOYES"
Help: https://docs.oracle.com/error-help/db/ora-41900/


SQL> ROLLBACK;

Rollback complete.

SQL> UPDATE rh.employes SET poste = 'Architecte';

8 rows updated.

SQL> ROLLBACK;

Rollback complete.

