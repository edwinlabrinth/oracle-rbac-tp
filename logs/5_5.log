SQL> -- POL_DBA : auditer le rôle DBA (couvre tous ses privilèges)
SQL> PROMPT === POL_DBA : creation et activation ===
=== POL_DBA : creation et activation ===
SQL> CREATE AUDIT POLICY pol_dba ROLES dba;

Audit policy created.

SQL> AUDIT POLICY pol_dba;

Audit succeeded.

SQL> 
SQL> -- Accorder DBA à A1
SQL> PROMPT === GRANT dba TO a1 ===
=== GRANT dba TO a1 ===
SQL> GRANT dba TO a1;

Grant succeeded.

SQL> 
SQL> -- A1 se reconnecte, active le rôle DBA, crée un utilisateur temporaire
SQL> PROMPT === A1 : SET ROLE dba + CREATE USER test_dba ===
=== A1 : SET ROLE dba + CREATE USER test_dba ===
SQL> CONNECT a1/"A1#2026"@//localhost/FREEPDB1
Connected.
SQL> SET ROLE dba;

Role set.

SQL> CREATE USER test_dba IDENTIFIED BY "Test#2026";

User created.

SQL> 
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> -- Retirer DBA à A1 et supprimer l'utilisateur temporaire
SQL> PROMPT === REVOKE dba FROM a1 puis DROP USER test_dba ===
=== REVOKE dba FROM a1 puis DROP USER test_dba ===
SQL> REVOKE dba FROM a1;

Revoke succeeded.

SQL> DROP USER test_dba;

User dropped.

