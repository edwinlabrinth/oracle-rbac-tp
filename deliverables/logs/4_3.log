SQL> -- 4_3.sql : Exercice 4.3 -- Expiration, gracetime et reutilisation des mots de passe
SQL> SET LINESIZE 120 PAGESIZE 50
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> -- Etape 1 : regles de reutilisation (30 jours, max 3 mots de passe memorises)
SQL> ALTER PROFILE p_rh_test LIMIT
  2    PASSWORD_REUSE_TIME 30
  3    PASSWORD_REUSE_MAX 3;

Profile altered.

SQL> 
SQL> COLUMN profile FORMAT A14
SQL> COLUMN resource_name FORMAT A30
SQL> COLUMN limit FORMAT A12
SQL> PROMPT === Regles de reutilisation de P_RH_TEST ===
=== Regles de reutilisation de P_RH_TEST ===
SQL> SELECT resource_name, limit
  2    FROM dba_profiles
  3   WHERE profile = 'P_RH_TEST'
  4  	AND resource_name IN ('PASSWORD_REUSE_TIME','PASSWORD_REUSE_MAX');

RESOURCE_NAME		       LIMIT
------------------------------ ------------
PASSWORD_REUSE_TIME	       30
PASSWORD_REUSE_MAX	       3

2 rows selected.

SQL> 
SQL> -- Etape 2 : LINA change son mot de passe (Lina#2029 -> Lina#2030), puis tente de reprendre l'ancien
SQL> PROMPT === LINA change son mot de passe (Lina#2029 -> Lina#2030) ===
=== LINA change son mot de passe (Lina#2029 -> Lina#2030) ===
SQL> CONNECT lina/"Lina#2029"@//localhost/FREEPDB1
Connected.
SQL> ALTER USER lina IDENTIFIED BY "Lina#2030" REPLACE "Lina#2029";

User altered.

SQL> PROMPT === Tentative de reprendre l'ancien mot de passe Lina#2029 (attendu ORA-28007) ===
=== Tentative de reprendre l'ancien mot de passe Lina#2029 (attendu ORA-28007) ===
SQL> ALTER USER lina IDENTIFIED BY "Lina#2029";

User altered.

SQL> 
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> -- Etape 3 : duree de vie et gracetime courtes (1 minute chacune)
SQL> ALTER PROFILE p_rh_test LIMIT
  2    PASSWORD_LIFE_TIME 1/1440
  3    PASSWORD_GRACE_TIME 1/1440;

Profile altered.

SQL> -- L'admin change le mot de passe de Lina (nouveau mot de passe jamais utilise)
SQL> ALTER USER lina IDENTIFIED BY "Lina#2031";

User altered.

SQL> COLUMN account_status FORMAT A20
SQL> COLUMN expiry_date FORMAT A20
SQL> PROMPT === Etat de LINA juste apres le changement par l'admin ===
=== Etat de LINA juste apres le changement par l'admin ===
