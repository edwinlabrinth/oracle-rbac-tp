SQL> 
SQL> -- Seule porte d'entrée pour les mouvements d'argent (droits du définisseur)
SQL> CREATE OR REPLACE PROCEDURE banque.p_operation (
  2    p_compte NUMBER, p_type VARCHAR2, p_montant NUMBER) AS
  3    v_solde banque.comptes.solde%TYPE;
  4  BEGIN
  5    IF p_montant <= 0 OR p_type NOT IN ('DEPOT','RETRAIT') THEN
  6  	 RAISE_APPLICATION_ERROR(-20001, 'Opération invalide');
  7    END IF;
  8    SELECT solde INTO v_solde FROM banque.comptes WHERE compte_id = p_compte FOR UPDATE;
  9    IF p_type = 'RETRAIT' AND v_solde < p_montant THEN
 10  	 RAISE_APPLICATION_ERROR(-20002, 'Solde insuffisant');
 11    END IF;
 12    UPDATE banque.comptes
 13  	  SET solde = solde + CASE p_type WHEN 'DEPOT' THEN p_montant ELSE -p_montant END
 14  	WHERE compte_id = p_compte;
 15    INSERT INTO banque.operations (compte_id, type_op, montant, agent)
 16    VALUES (p_compte, p_type, p_montant, SYS_CONTEXT('USERENV','SESSION_USER'));
 17    COMMIT;
 18  END;
 19  /

Procedure created.

