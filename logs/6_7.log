SQL> COLUMN username FORMAT A14
SQL> COLUMN profile FORMAT A16
SQL> COLUMN account_status FORMAT A14
SQL> COLUMN expiry_date FORMAT A16
SQL> COLUMN roles FORMAT A60
SQL> PROMPT === Requete 1 : utilisateurs metier - profil, etat, expiration, roles (LISTAGG) ===
=== Requete 1 : utilisateurs metier - profil, etat, expiration, roles (LISTAGG) ===
SQL> SELECT u.username,
  2  	    u.profile,
  3  	    u.account_status,
  4  	    TO_CHAR(u.expiry_date, 'DD-MON-YYYY') AS expiry_date,
  5  	    LISTAGG(rp.granted_role, ', ') WITHIN GROUP (ORDER BY rp.granted_role) AS roles
  6    FROM dba_users u
  7    LEFT JOIN dba_role_privs rp ON u.username = rp.grantee
  8   WHERE u.username IN ('GUI1','GUI2','CONS1','DIR1','AUD1','APP_BATCH','DEV_BQ','GUI3')
  9   GROUP BY u.username, u.profile, u.account_status, u.expiry_date
 10   ORDER BY u.username;

