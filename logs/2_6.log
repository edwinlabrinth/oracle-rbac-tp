SQL> SELECT u.username, p.privilege
  2    FROM dba_sys_privs p
  3    JOIN dba_users u ON u.username = p.grantee
  4   WHERE u.oracle_maintained = 'N'
  5  	AND p.privilege LIKE '%ANY%'
  6   ORDER BY u.username, p.privilege;

