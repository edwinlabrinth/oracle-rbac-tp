SQL> CREATE USER chu NO AUTHENTICATION DEFAULT TABLESPACE users QUOTA UNLIMITED ON users;

User created.

SQL> 
SQL> CREATE TABLE chu.services (
  2    service_id NUMBER PRIMARY KEY,
  3    nom	  VARCHAR2(40) NOT NULL,
  4    batiment   VARCHAR2(10));

Table created.

SQL> 
SQL> CREATE TABLE chu.personnel (
  2    pers_id	     NUMBER PRIMARY KEY,
  3    nom	     VARCHAR2(40) NOT NULL,
  4    prenom	     VARCHAR2(40),
  5    fonction	VARCHAR2(12) CHECK (fonction IN ('MEDECIN','INFIRMIER','SECRETAIRE','PHARMACIEN','COMPTABLE','DIRECTEUR','DPO')),
  6    service_id	NUMBER REFERENCES chu.services,
  7    login	     VARCHAR2(30) UNIQUE,
  8    date_embauche DATE);

Table created.

SQL> 
SQL> CREATE TABLE chu.patients (
  2    patient_id	 NUMBER PRIMARY KEY,
  3    cin	      VARCHAR2(10) UNIQUE,
  4    nom	      VARCHAR2(40) NOT NULL,
  5    prenom	      VARCHAR2(40),
  6    date_naissance DATE,
  7    sexe	      CHAR(1) CHECK (sexe IN ('F','M')),
  8    telephone	 VARCHAR2(15),
  9    ville	      VARCHAR2(30),
 10    mutuelle	 VARCHAR2(10) CHECK (mutuelle IN ('CNSS','CNOPS','AMO','AUCUNE')),
 11    vip	      CHAR(1) DEFAULT 'N' CHECK (vip IN ('O','N')));

Table created.

SQL> 
SQL> CREATE TABLE chu.sejours (
  2    sejour_id   NUMBER PRIMARY KEY,
  3    patient_id  NUMBER NOT NULL REFERENCES chu.patients,
  4    service_id  NUMBER NOT NULL REFERENCES chu.services,
  5    medecin_id  NUMBER NOT NULL REFERENCES chu.personnel,
  6    date_entree DATE NOT NULL,
  7    date_sortie DATE,
  8    motif	   VARCHAR2(60));

Table created.

SQL> 
SQL> CREATE TABLE chu.dossiers_medicaux (
  2    dossier_id   NUMBER PRIMARY KEY,
  3    sejour_id    NUMBER NOT NULL UNIQUE REFERENCES chu.sejours,
  4    diagnostic   VARCHAR2(80),
  5    antecedents  VARCHAR2(80),
  6    traitement   VARCHAR2(80),
  7    confidentiel CHAR(1) DEFAULT 'N' CHECK (confidentiel IN ('O','N')),
  8    maj_le	    DATE);

Table created.

SQL> 
SQL> CREATE TABLE chu.prescriptions (
  2    presc_id   NUMBER PRIMARY KEY,
  3    sejour_id  NUMBER NOT NULL REFERENCES chu.sejours,
  4    medecin_id NUMBER NOT NULL REFERENCES chu.personnel,
  5    medicament VARCHAR2(40) NOT NULL,
  6    dose	  VARCHAR2(30),
  7    date_presc DATE,
  8    statut	  VARCHAR2(10) CHECK (statut IN ('PRESCRITE','DELIVREE','ANNULEE')));

Table created.

SQL> 
SQL> CREATE TABLE chu.factures (
  2    facture_id	NUMBER PRIMARY KEY,
  3    sejour_id	NUMBER NOT NULL REFERENCES chu.sejours,
  4    montant	     NUMBER(10,2),
  5    part_mutuelle NUMBER(10,2),
  6    statut	     VARCHAR2(8) CHECK (statut IN ('EMISE','PAYEE')),
  7    date_emission DATE);

Table created.

