SQL> -- Vue réservée à la direction : statistiques, sans aucune donnée nominative
SQL> CREATE VIEW chu.v_stats_services AS
  2    SELECT sv.nom AS service, COUNT(s.sejour_id) AS nb_sejours,
  3  	      ROUND(AVG(NVL(s.date_sortie, SYSDATE) - s.date_entree), 1) AS dms_jours,
  4  	      SUM(f.montant) AS ca_factures
  5    FROM	 chu.services sv
  6    LEFT JOIN chu.sejours s	ON s.service_id = sv.service_id
  7    LEFT JOIN chu.factures f ON f.sejour_id = s.sejour_id
  8    GROUP  BY sv.nom;

View created.

SQL> 
SQL> -- Vue du secrétariat : identité et séjours, sans données médicales
SQL> CREATE VIEW chu.v_accueil AS
  2    SELECT s.sejour_id, p.patient_id, p.nom, p.prenom, p.date_naissance, p.telephone,
  3  	      p.mutuelle, sv.nom AS service, s.date_entree, s.date_sortie
  4    FROM	 chu.sejours s JOIN chu.patients p  ON p.patient_id = s.patient_id
  5  			    JOIN chu.services sv ON sv.service_id = s.service_id;

View created.

SQL> 
SQL> -- Vue des infirmiers : dossiers NON confidentiels uniquement
SQL> CREATE VIEW chu.v_soins AS
  2    SELECT d.dossier_id, s.sejour_id, p.nom, p.prenom, sv.nom AS service,
  3  	      d.diagnostic, d.traitement
  4    FROM	 chu.dossiers_medicaux d JOIN chu.sejours s  ON s.sejour_id = d.sejour_id
  5  				      JOIN chu.patients p  ON p.patient_id = s.patient_id
  6  				      JOIN chu.services sv ON sv.service_id = s.service_id
  7    WHERE  d.confidentiel = 'N';

