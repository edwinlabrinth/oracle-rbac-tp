SQL> 
SQL> -- P_BQ_AGENT : guichetiers (E4 : 1 session, IDLE 10 min, 3 échecs, verrouillage 30 min,
SQL> -- vie 60 jours, non réutilisable avant un an, fonction de verification)
SQL> PROMPT === Creation du profil P_BQ_AGENT ===
=== Creation du profil P_BQ_AGENT ===
SQL> CREATE PROFILE p_bq_agent LIMIT
  2    SESSIONS_PER_USER 1
  3    IDLE_TIME 10
  4    FAILED_LOGIN_ATTEMPTS 3
  5    PASSWORD_LOCK_TIME 30/1440
  6    PASSWORD_LIFE_TIME 60
  7    PASSWORD_GRACE_TIME 7
  8    PASSWORD_REUSE_TIME 365
  9    PASSWORD_REUSE_MAX 5
 10    PASSWORD_VERIFY_FUNCTION ORA12C_VERIFY_FUNCTION;

Profile created.

SQL> 
SQL> -- P_BQ_CONSEIL : meme profil que l'agent mais 2 sessions (conseiller)
SQL> PROMPT === Creation du profil P_BQ_CONSEIL (2 sessions pour le conseiller) ===
=== Creation du profil P_BQ_CONSEIL (2 sessions pour le conseiller) ===
SQL> CREATE PROFILE p_bq_conseil LIMIT
  2    SESSIONS_PER_USER 2
  3    IDLE_TIME 10
  4    FAILED_LOGIN_ATTEMPTS 3
  5    PASSWORD_LOCK_TIME 30/1440
  6    PASSWORD_LIFE_TIME 60
  7    PASSWORD_GRACE_TIME 7
  8    PASSWORD_REUSE_TIME 365
  9    PASSWORD_REUSE_MAX 5
 10    PASSWORD_VERIFY_FUNCTION ORA12C_VERIFY_FUNCTION;

Profile created.

SQL> 
SQL> -- P_BQ_SENSIBLE : directeur et auditeur, meme regles E4 + E5 (fonction forte)
SQL> PROMPT === Creation du profil P_BQ_SENSIBLE (fonction de verification forte) ===
=== Creation du profil P_BQ_SENSIBLE (fonction de verification forte) ===
SQL> CREATE PROFILE p_bq_sensible LIMIT
  2    SESSIONS_PER_USER 1
  3    IDLE_TIME 10
  4    FAILED_LOGIN_ATTEMPTS 3
  5    PASSWORD_LOCK_TIME 30/1440
  6    PASSWORD_LIFE_TIME 60
  7    PASSWORD_GRACE_TIME 7
  8    PASSWORD_REUSE_TIME 365
  9    PASSWORD_REUSE_MAX 5
 10    PASSWORD_VERIFY_FUNCTION ORA12C_STRONG_VERIFY_FUNCTION;

Profile created.

SQL> 
SQL> -- P_BQ_SERVICE : batch, pas d'expiration, durci autrement
SQL> PROMPT === Creation du profil P_BQ_SERVICE (batch) ===
=== Creation du profil P_BQ_SERVICE (batch) ===
SQL> CREATE PROFILE p_bq_service LIMIT
  2    SESSIONS_PER_USER DEFAULT
  3    IDLE_TIME DEFAULT
  4    FAILED_LOGIN_ATTEMPTS 5
  5    PASSWORD_LOCK_TIME 15/1440
  6    PASSWORD_LIFE_TIME UNLIMITED
  7    PASSWORD_GRACE_TIME DEFAULT
  8    PASSWORD_REUSE_TIME 365
  9    PASSWORD_REUSE_MAX 5
 10    PASSWORD_VERIFY_FUNCTION ORA12C_STRONG_VERIFY_FUNCTION;

Profile created.

SQL> 
SQL> COLUMN profile FORMAT A16
SQL> COLUMN resource_name FORMAT A30
SQL> COLUMN limit FORMAT A14
SQL> PROMPT === Resume des profils Banque ===
=== Resume des profils Banque ===
SQL> SELECT profile, resource_name, limit
