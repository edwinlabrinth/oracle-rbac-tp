SQL> -- 1_2.sql : Exercice 1.2 -- Quotas et création différée
SQL> SET LINESIZE 120 PAGESIZE 50
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> -- 1. Droit de créer des tables pour ALI
SQL> GRANT CREATE TABLE TO ali;

Grant succeeded.

SQL> 
SQL> -- 2. Création de la table en ALI (réussit) puis insertion (doit échouer faute de quota)
SQL> CONNECT ali/"Ali#2026"@//localhost/FREEPDB1
Connected.
SQL> CREATE TABLE notes (id NUMBER, texte VARCHAR2(4000));

Table created.

SQL> INSERT INTO notes VALUES (1, 'premiere ligne');
INSERT INTO notes VALUES (1, 'premiere ligne')
            *
ERROR at line 1:
ORA-01950: The user ALI has insufficient quota on tablespace USERS.
Help: https://docs.oracle.com/error-help/db/ora-01950/


SQL> 
SQL> -- 3. Attribution d'un quota de 1 Mo sur USERS, puis nouvelle insertion
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> ALTER USER ali QUOTA 1M ON users;

User altered.

SQL> CONNECT ali/"Ali#2026"@//localhost/FREEPDB1
Connected.
SQL> INSERT INTO notes VALUES (1, 'premiere ligne apres quota');

1 row created.

SQL> SELECT COUNT(*) AS nb_lignes FROM notes;

 NB_LIGNES
----------
	 1

1 row selected.

