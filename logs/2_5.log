SQL> -- 2_5.sql : Exercice 2.5 -- ADMIN OPTION : pas de cascade
SQL> SET LINESIZE 120 PAGESIZE 50
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> -- 1. CREATE VIEW avec ADMIN OPTION pour A1, puis A1 le transmet a A2
SQL> GRANT CREATE VIEW TO a1 WITH ADMIN OPTION;

Grant succeeded.

SQL> CONNECT a1/"A1#2026"@//localhost/FREEPDB1
Connected.
SQL> GRANT CREATE VIEW TO a2;

Grant succeeded.

SQL> 
SQL> -- 2. Revocation a A1
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> REVOKE CREATE VIEW FROM a1;

Revoke succeeded.

SQL> 
SQL> -- 3. A2 possede-t-il encore le privilege ?
SQL> CONNECT a2/"A2#2026"@//localhost/FREEPDB1
Connected.
SQL> COLUMN privilege FORMAT A20
SQL> SELECT privilege FROM user_sys_privs WHERE privilege = 'CREATE VIEW';

PRIVILEGE
--------------------
CREATE VIEW

1 row selected.

SQL> 
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> COLUMN grantee FORMAT A10
SQL> PROMPT === DBA_SYS_PRIVS pour A1 et A2 ===
=== DBA_SYS_PRIVS pour A1 et A2 ===
SQL> SELECT grantee, privilege, admin_option
  2    FROM dba_sys_privs
  3   WHERE grantee IN ('A1','A2') AND privilege = 'CREATE VIEW'
  4   ORDER BY grantee;

GRANTEE    PRIVILEGE		ADM
---------- -------------------- ---
A2	   CREATE VIEW		NO

1 row selected.

