Connected.
SQL> 
SQL> COLUMN utilisateur FORMAT A12
SQL> COLUMN role FORMAT A20
SQL> COLUMN table_name FORMAT A25
SQL> COLUMN privilege FORMAT A15
SQL> PROMPT === Privilèges objet effectifs via les rôles (contrôle E1/E2) ===
=== Privilèges objet effectifs via les rôles (contrôle E1/E2) ===
SQL> SELECT rp.grantee AS utilisateur, tp.grantee AS role, tp.table_name, tp.privilege
  2    FROM dba_tab_privs tp
  3   JOIN dba_role_privs rp ON tp.grantee = rp.granted_role
  4   WHERE rp.grantee IN ('GUI1','GUI2','CONS1','DIR1','AUD1','APP_BATCH','DEV_BQ')
  5   ORDER BY rp.grantee, tp.table_name, tp.privilege;

