SQL> -- 1_3.sql : Exercice 1.3 -- Cycle de vie d'un compte (expiration du mot de passe)
SQL> SET LINESIZE 120 PAGESIZE 50
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> COLUMN username FORMAT A12
SQL> COLUMN account_status FORMAT A16
SQL> COLUMN lock_date FORMAT A20
SQL> COLUMN expiry_date FORMAT A20
SQL> 
SQL> PROMPT === Etat initial du compte ALI ===
=== Etat initial du compte ALI ===
SQL> SELECT username, account_status, lock_date, expiry_date
  2    FROM dba_users WHERE username = 'ALI';

USERNAME     ACCOUNT_STATUS   LOCK_DATE 	   EXPIRY_DATE
------------ ---------------- -------------------- --------------------
ALI	     OPEN

1 row selected.

SQL> 
SQL> -- 1. Expiration du mot de passe
SQL> ALTER USER ali PASSWORD EXPIRE;

User altered.

SQL> 
SQL> PROMPT === Etat apres ALTER USER ali PASSWORD EXPIRE ===
=== Etat apres ALTER USER ali PASSWORD EXPIRE ===
SQL> SELECT username, account_status, lock_date, expiry_date
  2    FROM dba_users WHERE username = 'ALI';

USERNAME     ACCOUNT_STATUS   LOCK_DATE 	   EXPIRY_DATE
------------ ---------------- -------------------- --------------------
ALI	     EXPIRED				   29-OCT-26

1 row selected.

SQL> 
SQL> -- 2. Tentative de connexion avec le mot de passe expire : SQL*Plus propose le changement
SQL> CONNECT ali/"Ali#2026"@//localhost/FREEPDB1
ERROR:
ORA-28001: The account has expired. The password must be changed.
Help: https://docs.oracle.com/error-help/db/ora-28001/


Changing password for ali
New password: 
Retype new password: 
ERROR:
ORA-00988: missing or invalid passwords
Help: https://docs.oracle.com/error-help/db/ora-00988/


Password unchanged
Warning: You are no longer connected to ORACLE.
SQL> 
SQL> -- Etat apres la tentative (le mot de passe n'a pas encore ete change)
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> PROMPT === Etat apres tentative de connexion ===
=== Etat apres tentative de connexion ===
SQL> SELECT username, account_status, lock_date, expiry_date
  2    FROM dba_users WHERE username = 'ALI';

USERNAME     ACCOUNT_STATUS   LOCK_DATE 	   EXPIRY_DATE
------------ ---------------- -------------------- --------------------
ALI	     EXPIRED				   29-OCT-26

1 row selected.

SQL> EXIT
