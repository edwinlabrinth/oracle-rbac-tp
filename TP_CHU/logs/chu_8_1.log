SQL> -- Procedure LOG_EVT (transaction autonome)
SQL> PROMPT === Creation de LOG_EVT ===
=== Creation de LOG_EVT ===
SQL> CREATE OR REPLACE PROCEDURE audit_chu.log_evt (
  2    p_type	    VARCHAR2,
  3    p_objet	    VARCHAR2,
  4    p_detail     VARCHAR2
  5  ) AS
  6    PRAGMA AUTONOMOUS_TRANSACTION;
  7    v_utilisateur VARCHAR2(30);
  8    v_proxy	     VARCHAR2(30);
  9    v_poste	     VARCHAR2(60);
 10    v_programme	VARCHAR2(60);
 11  BEGIN
 12    SELECT SYS_CONTEXT('USERENV','SESSION_USER'),
 13  	      SYS_CONTEXT('USERENV','PROXY_USER'),
 14  	      SYS_CONTEXT('USERENV','HOST'),
 15  	      SYS_CONTEXT('USERENV','CLIENT_PROGRAM_NAME')
 16  	 INTO v_utilisateur, v_proxy, v_poste, v_programme
 17  	 FROM dual;
 18    INSERT INTO audit_chu.journal_evenements
 19  	 (type_evenement, utilisateur, utilisateur_proxy, poste, programme, objet, detail)
 20    VALUES (p_type, v_utilisateur, v_proxy, v_poste, v_programme, p_objet, p_detail);
 21    COMMIT;
 22  END;
 23  /

Procedure created.

