SQL> -- 4_2.sql : Exercice 4.2 -- Verrouillage apres echecs
SQL> SET LINESIZE 120 PAGESIZE 50
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> ALTER PROFILE p_rh_test LIMIT
  2    FAILED_LOGIN_ATTEMPTS 3
  3    PASSWORD_LOCK_TIME 2/1440;

Profile altered.

SQL> 
