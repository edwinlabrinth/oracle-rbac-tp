SQL> -- Trigger : apres UPDATE sur diagnostic, traitement ou confidentialite, pour chaque ligne
SQL> PROMPT === Creation de TRG_AUD_DOSSIERS ===
=== Creation de TRG_AUD_DOSSIERS ===
SQL> CREATE OR REPLACE TRIGGER trg_aud_dossiers
  2    AFTER UPDATE OF diagnostic, traitement, confidentiel ON chu.dossiers_medicaux
  3    FOR EACH ROW
  4    WHEN (OLD.diagnostic <> NEW.diagnostic OR OLD.traitement <> NEW.traitement OR OLD.confidentiel <> NEW.confidentiel)
  5  BEGIN
  6    INSERT INTO audit_chu.journal_dossiers
  7  	 (utilisateur, utilisateur_proxy, poste, programme,
  8  	  dossier_id,
  9  	  ancien_diagnostic, nouveau_diagnostic,
 10  	  ancien_traitement, nouveau_traitement,
 11  	  ancien_confidentiel, nouveau_confidentiel)
 12    VALUES
 13  	 (SYS_CONTEXT('USERENV','SESSION_USER'),
 14  	  SYS_CONTEXT('USERENV','PROXY_USER'),
 15  	  SYS_CONTEXT('USERENV','HOST'),
 16  	  SYS_CONTEXT('USERENV','CLIENT_PROGRAM_NAME'),
 17  	  :NEW.dossier_id,
 18  	  :OLD.diagnostic, :NEW.diagnostic,
 19  	  :OLD.traitement, :NEW.traitement,
 20  	  :OLD.confidentiel, :NEW.confidentiel);
 21  END;
 22  /

Trigger created.

