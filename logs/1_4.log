SQL> -- 1_4.sql : Exercice 1.4 -- Compte schema seul et proxy
SQL> SET LINESIZE 120 PAGESIZE 50
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> -- 1. Tentative de connexion directe au compte schema seul RH
SQL> CONNECT rh/"nimportequoi"@//localhost/FREEPDB1
ERROR:
ORA-01017: invalid credential or not authorized; logon denied
Help: https://docs.oracle.com/error-help/db/ora-01017/


Warning: You are no longer connected to ORACLE.
SQL> 
SQL> -- 2. Creation de DEV1 et autorisation de connexion a travers RH
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> CREATE USER dev1 IDENTIFIED BY "Dev1#2026";

User created.

SQL> GRANT CREATE SESSION TO dev1;

Grant succeeded.

SQL> ALTER USER rh GRANT CONNECT THROUGH dev1;

User altered.

SQL> 
SQL> -- Premiere tentative proxy : RH n'a pas encore CREATE SESSION
SQL> CONNECT dev1[rh]/"Dev1#2026"@//localhost/FREEPDB1
ERROR:
ORA-01045: Login denied. User RH does not have CREATE SESSION privilege.
Help: https://docs.oracle.com/error-help/db/ora-01045/


Warning: You are no longer connected to ORACLE.
SQL> 
SQL> -- On accorde CREATE SESSION a RH, puis on reessaie
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> GRANT CREATE SESSION TO rh;

Grant succeeded.

SQL> 
SQL> -- 3. Connexion effective en proxy dev1[rh]
SQL> CONNECT dev1[rh]/"Dev1#2026"@//localhost/FREEPDB1
Connected.
