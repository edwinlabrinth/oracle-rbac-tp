SQL> -- 5_3.sql : Exercice 5.3 -- Tracer l'administration des comptes (ORA_ACCOUNT_MGMT)
SQL> SET LINESIZE 120 PAGESIZE 50
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> -- Activation de la politique predefinie ORA_ACCOUNT_MGMT (gestion des comptes)
SQL> PROMPT === Activation de la politique ORA_ACCOUNT_MGMT ===
=== Activation de la politique ORA_ACCOUNT_MGMT ===
SQL> AUDIT POLICY ora_account_mgmt;

Audit succeeded.

SQL> 
SQL> -- Creation de STAGIAIRE, octroi puis retrait de R_RH_LECTEUR, suppression
SQL> PROMPT === Creation de STAGIAIRE ===
=== Creation de STAGIAIRE ===
SQL> CREATE USER stagiaire IDENTIFIED BY "Stagiaire#2026";

User created.

SQL> GRANT CREATE SESSION TO stagiaire;

Grant succeeded.

SQL> 
SQL> PROMPT === Octroi de R_RH_LECTEUR à STAGIAIRE ===
=== Octroi de R_RH_LECTEUR à STAGIAIRE ===
SQL> GRANT r_rh_lecteur TO stagiaire;

Grant succeeded.

SQL> 
SQL> PROMPT === Retrait de R_RH_LECTEUR à STAGIAIRE ===
=== Retrait de R_RH_LECTEUR à STAGIAIRE ===
SQL> REVOKE r_rh_lecteur FROM stagiaire;

Revoke succeeded.

SQL> 
SQL> PROMPT === Suppression de STAGIAIRE ===
=== Suppression de STAGIAIRE ===
SQL> DROP USER stagiaire;

User dropped.

SQL> 
