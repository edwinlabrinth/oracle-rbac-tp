SQL> -- Politique FGA sur RH.EMPLOYES : audit quand SALAIRE > 30000, colonne SALAIRE
SQL> PROMPT === Creation de la politique FGA FGA_GROS_SALAIRES ===
=== Creation de la politique FGA FGA_GROS_SALAIRES ===
SQL> BEGIN
  2    DBMS_FGA.ADD_POLICY(
  3  	 object_schema	 => 'RH',
  4  	 object_name	 => 'EMPLOYES',
  5  	 policy_name	 => 'FGA_GROS_SALAIRES',
  6  	 audit_condition => 'SALAIRE > 30000',
  7  	 audit_column	 => 'SALAIRE',
  8  	 statement_types => 'SELECT,UPDATE',
  9  	 enable 	 => TRUE);
 10  END;
 11  /

PL/SQL procedure successfully completed.

