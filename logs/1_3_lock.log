SQL> -- 1_3_lock.sql : Exercice 1.3 (suite) -- verrouillage et deverrouillage du compte
SQL> SET LINESIZE 120 PAGESIZE 50
SQL> CONNECT sys/"Admin#2026"@//localhost/FREEPDB1 AS SYSDBA
Connected.
SQL> 
SQL> COLUMN username FORMAT A12
SQL> COLUMN account_status FORMAT A16
SQL> COLUMN lock_date FORMAT A20
SQL> COLUMN expiry_date FORMAT A20
SQL> 
SQL> PROMPT === Etat apres changement du mot de passe (Ali#2027) ===
=== Etat apres changement du mot de passe (Ali#2027) ===
SQL> SELECT username, account_status, lock_date, expiry_date
  2    FROM dba_users WHERE username = 'ALI';

USERNAME     ACCOUNT_STATUS   LOCK_DATE 	   EXPIRY_DATE
