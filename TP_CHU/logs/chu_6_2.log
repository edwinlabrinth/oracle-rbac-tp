SQL> -- 1. POL_CHU_DOSSIERS : SELECT, INSERT, UPDATE, DELETE sur dossiers_medicaux + SELECT sur v_soins
SQL> -- 			pour tous les comptes SAUF APP_CHU
SQL> PROMPT === Creation POL_CHU_DOSSIERS ===
=== Creation POL_CHU_DOSSIERS ===
SQL> CREATE AUDIT POLICY pol_chu_dossiers
  2    ACTIONS SELECT, INSERT, UPDATE, DELETE ON chu.dossiers_medicaux,
  3  	       SELECT ON chu.v_soins;

Audit policy created.

SQL> PROMPT === Activation POL_CHU_DOSSIERS (EXCEPT app_chu) ===
=== Activation POL_CHU_DOSSIERS (EXCEPT app_chu) ===
SQL> AUDIT POLICY pol_chu_dossiers EXCEPT app_chu;

Audit succeeded.

SQL> 
SQL> -- 2. POL_CHU_ADHOC : INSERT, UPDATE, DELETE sur PATIENTS, PRESCRIPTIONS, FACTURES
SQL> -- 		   uniquement quand le programme client est SQL*Plus ou SQL Developer
SQL> -- 		   (evaluation par session)
SQL> PROMPT === Creation POL_CHU_ADHOC (clause WHEN sur CLIENT_PROGRAM_NAME) ===
=== Creation POL_CHU_ADHOC (clause WHEN sur CLIENT_PROGRAM_NAME) ===
SQL> CREATE AUDIT POLICY pol_chu_adhoc
  2    ACTIONS INSERT, UPDATE, DELETE ON chu.patients,
  3  	       INSERT, UPDATE, DELETE ON chu.prescriptions,
  4  	       INSERT, UPDATE, DELETE ON chu.factures
  5    WHEN 'SYS_CONTEXT(''USERENV'',''CLIENT_PROGRAM_NAME'') LIKE ''%sqlplus%'' OR SYS_CONTEXT(''USERENV'',''CLIENT_PROGRAM_NAME'') LIKE ''%sqldeveloper%''' EVALUATE PER SESSION;

Audit policy created.

SQL> PROMPT === Activation POL_CHU_ADHOC ===
=== Activation POL_CHU_ADHOC ===
SQL> AUDIT POLICY pol_chu_adhoc;

Audit succeeded.

SQL> 
