SQL> -- Lecture de la trace (2 dernières minutes, politique POL_DBA + actions admin)
SQL> COLUMN event_timestamp FORMAT A22
SQL> COLUMN dbusername FORMAT A12
SQL> COLUMN action_name FORMAT A20
SQL> COLUMN object_name FORMAT A20
SQL> COLUMN unified_audit_policies FORMAT A22
SQL> COLUMN sql_text FORMAT A45
SQL> PROMPt === Traces POL_DBA (role DBA) + actions admin - 2 min ===
=== Traces POL_DBA (role DBA) + actions admin - 2 min ===
SQL> SELECT event_timestamp, dbusername, action_name, object_name,
  2  	    unified_audit_policies, sql_text
  3    FROM unified_audit_trail
  4   WHERE (unified_audit_policies LIKE '%POL_DBA%'
  5  	     OR action_name IN ('CREATE USER','DROP USER','GRANT','REVOKE'))
  6  	AND event_timestamp > SYSTIMESTAMP - INTERVAL '2' MINUTE
  7   ORDER BY event_timestamp;

